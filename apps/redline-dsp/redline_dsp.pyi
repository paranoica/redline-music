import numpy as np
import numpy.typing as npt

Plan = tuple[list[float], int, int, int, int]

def oversampled_clip(
    samples: npt.NDArray[np.float32],
    gain: float,
    ceiling: float,
    up: Plan,
    down: Plan,
    sos: list[list[float]],
    zi: list[list[float]],
    edge: int,
    passes: int,
) -> npt.NDArray[np.float32]: ...
def integrated_loudness(
    samples: npt.NDArray[np.float32],
    rate: float,
    stages: list[tuple[list[float], list[float], float]],
    block: float,
    overlap: float,
) -> float: ...
def resample(samples: npt.NDArray[np.float32], plan: Plan) -> npt.NDArray[np.float32]: ...
def sosfilt(
    samples: npt.NDArray[np.float32], sos: list[list[float]]
) -> npt.NDArray[np.float32]: ...
def rack_process(
    samples: npt.NDArray[np.float32],
    rate: float,
    rack_json: str,
    side: npt.NDArray[np.float32] | None = None,
) -> npt.NDArray[np.float32]: ...
def rack_process_automated(
    samples: npt.NDArray[np.float32],
    rate: float,
    rack_json: str,
    lanes: list[tuple[int, str, list[tuple[float, float]]]],
    side: npt.NDArray[np.float32] | None = None,
) -> npt.NDArray[np.float32]: ...
def rack_effects() -> str: ...
def rack_alignment(rate: float, rack_json: str) -> tuple[int, int]: ...
def beat_check(score_json: str) -> list[str]: ...
def beat_events(score_json: str, rate: float) -> str: ...
def beat_instruments() -> str: ...
def beat_render(score_json: str, rate: float) -> npt.NDArray[np.float32]: ...

class BeatPlayer:
    def __init__(self, score_json: str, rate: float) -> None: ...
    def load_zone(
        self,
        library: str,
        root: int,
        vel_lo: int,
        vel_hi: int,
        rate: float,
        samples: npt.NDArray[np.int16],
    ) -> None: ...
    def rebuild_samplers(self) -> None: ...
    def process(self, frames: int) -> tuple[npt.NDArray[np.float32], npt.NDArray[np.float32]]: ...
    def seek(self, frame: int) -> None: ...
    @property
    def latency(self) -> int: ...
    @property
    def stem_latency(self) -> int: ...
    @property
    def length(self) -> int: ...
    @property
    def end(self) -> int: ...
    @property
    def sounds(self) -> list[str]: ...
    @property
    def position(self) -> int: ...
